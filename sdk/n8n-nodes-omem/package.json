{
  "name": "n8n-nodes-omem",
  "version": "0.1.0",
  "description": "OMEM for n8n: the system of record for what an AI agent believed and did. Remember, recall, believes, why. Keeps contradictions, proves provenance, self-hosted.",
  "keywords": ["n8n-community-node-package", "omem", "ai-agents", "memory", "audit-trail", "belief-revision"],
  "license": "MIT",
  "homepage": "https://infrastructure.omem-cloud.com",
  "author": { "name": "OMEM" },
  "repository": { "type": "git", "url": "https://github.com/troybrandonc-bit/Omem.git", "directory": "sdk/n8n-nodes-omem" },
  "main": "index.js",
  "files": ["dist"],
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('nodes/Omem/omem.svg','dist/nodes/Omem/omem.svg')\""
  },
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": ["dist/credentials/OmemApi.credentials.js"],
    "nodes": ["dist/nodes/Omem/Omem.node.js"]
  },
  "devDependencies": { "n8n-workflow": "^1.70.0", "typescript": "^5.5.0" },
  "peerDependencies": { "n8n-workflow": "*" }
}
