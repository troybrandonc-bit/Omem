# ── Authentication ─────────────────────────────────────────────────────────
# OMEM has two modes, and only one of them is safe on a network.
#
#   OMEM_AUTH=local     (default) No login. The dashboard provisions a session
#                       against the running server, which is what makes setup a
#                       minute. Local mode REFUSES to bind a non-loopback address
#                       unless OMEM_ALLOW_INSECURE_BIND=1 says the network is
#                       trusted — because with no passwords, being unreachable IS
#                       the access control.
#
#   OMEM_AUTH=password  Accounts have passwords (PBKDF2-SHA256). Required for any
#                       server other people can reach. Signup will not hand back a
#                       session for an address that already has a password, and
#                       the server refuses to start on the default master key.
# OMEM_AUTH=password

# Encrypts stored OAuth tokens. Password mode will not start without a real one:
# the development default is a constant published in this repository.
#   OMEM_MASTER_KEY=$(python3 -c 'import secrets;print(secrets.token_urlsafe(32))')
# OMEM_MASTER_KEY=

# Only if you understand the bind: acknowledges a non-loopback OMEM_HOST while
# still in local mode. Correct inside a container whose ports are published to
# 127.0.0.1; wrong on a host other machines can reach.
# OMEM_ALLOW_INSECURE_BIND=1

# Comma-separated emails that may reach /v1/admin/*, which spans every tenant.
# In local mode this is not a meaningful boundary, since anyone can hold any
# identity; set OMEM_AUTH=password before relying on it.
# OMEM_ADMIN_EMAILS=

# OMEM Cloud — API SERVER configuration.
# IMPORTANT: this file is read by the PYTHON API SERVER (server/api.py).
# A .env.local placed in web/ is a Next.js convention and is NOT read by the API.
# Copy this to server/.env.local and restart the API server.

# ── Gmail (real Google OAuth) ──────────────────────────────────────────────
# Google Cloud console -> APIs & Services -> Credentials -> OAuth client ID
# (Web application). Enable the Gmail API. Add the redirect URI below to the
# client's "Authorized redirect URIs" EXACTLY as written.
#
# EITHER value works — both ends serve /oauth/gmail/callback:
#   http://localhost:3000/oauth/gmail/callback   (frontend; nicer UX)
#   http://localhost:8787/oauth/gmail/callback   (API directly)
# Use whichever you registered in Google Cloud; they must match exactly.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/gmail/callback

# Gmail ingestion filter. Defaults exclude promotions/social/forums/updates and
# noreply-style senders so only real business correspondence is ingested.
# Override per connector via its config.query, e.g. "label:customers newer_than:90d".
# OMEM_GMAIL_QUERY=

# Where to send the browser back after a successful connection
OMEM_APP_URL=http://localhost:3000

# ── LLM extraction (any OpenAI-compatible endpoint) ────────────────────────
# OMEM_LLM_API_KEY=
# OMEM_LLM_BASE_URL=https://api.openai.com/v1
# OMEM_LLM_MODEL=gpt-4o-mini

# ── Billing (Stripe test mode) ─────────────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# ── GitHub connector (optional; raises rate limit 60 -> 5000 req/hour) ─────
# GITHUB_TOKEN=

# ── Infrastructure ─────────────────────────────────────────────────────────
# OMEM_DATABASE_URL=postgres://omem:omem-dev@127.0.0.1/omem
# OMEM_MASTER_KEY=change-me-in-production
# OMEM_ADMIN_EMAILS=you@yourcompany.com

# ── P9.1 encryption at rest ──
# DB-at-rest is a DEPLOYMENT concern: run production SQLite/Postgres on an
# encrypted volume or managed encrypted database. Omem does not re-encrypt the
# live DB in application code (keeps queries/indexes intact).
# Backup ARTIFACTS are a separate file and CAN be encrypted by Omem using the
# existing SecretsProvider (reuses OMEM_MASTER_KEY / OMEM_KMS_KEY_ID):
# OMEM_BACKUP_ENCRYPT=1
# OMEM_BACKUP_DIR=/var/lib/omem/backups   # must be on protected storage, 0700
# In production set a real OMEM_MASTER_KEY (or OMEM_KMS_KEY_ID); the built-in
# dev default is flagged insecure via /v1/memory backup status when OMEM_ENV=production.
